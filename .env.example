# 이 파일을 복사해 server/.env 로 저장하세요.  (cp .env.example server/.env)
# ⚠️ .env 는 서버에서만 읽습니다. 깃에 올리지 마세요(.gitignore 에 들어 있음).

PORT=3000

# 관리자 화면(/admin) 비밀번호. 비워 두면 서버를 켤 때마다 새 비밀번호가 터미널에 나옵니다.
ADMIN_PASSWORD=

# 방을 만들 때 필요한 교사 코드. 인터넷에 공개 배포할 때는 꼭 정해 주세요.
# 비워 두면 주소를 아는 누구나 방을 만들 수 있습니다(교실 와이파이 전용일 때만 권장).
TEACHER_CODE=

# 3D 변환 모드
#   pregenerated : (기본) 교사가 Higgsfield 에서 미리 만든 GLB 를 관리자 화면에서 올림 (B 모드)
#   mock         : 개발용. 크레딧 없이 몇 초 뒤 샘플 3D 차를 돌려줌
#   higgsfield   : 실시간(A 모드). 현재 Higgsfield 공개 API 에 3D 모델이 없어 검증되지 않았습니다.
GENERATOR=pregenerated
MOCK_DELAY_SEC=8
# 실시간 변환이 이 시간을 넘기면 포기하고 그림 차로 달립니다.
GEN_TIMEOUT_SEC=180

# 그림·3D 모델 자동 삭제까지 걸리는 시간
RETENTION_HOURS=24

# 인터넷에 배포했을 때의 주소 (QR 코드에 쓰임). 교실 와이파이에서 노트북으로 켤 때는 비워 두세요.
PUBLIC_URL=

# ── Supabase (선택) ─────────────────────────────────────────────
# 두 값을 모두 채우면 그림·GLB 를 Supabase Storage(비공개 버킷)에, 기록을 cars 테이블에 저장합니다.
# 비워 두면 이 컴퓨터의 data/ 폴더에 저장합니다.
# 키는 Supabase 대시보드 → Project Settings → API Keys 의 "secret" 키(sb_secret_...)를 쓰세요.
SUPABASE_URL=https://jucuqdiihcyqpjbttovf.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=race-assets

# ── Higgsfield 실시간 모드(A)용 (선택) ─────────────────────────
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_3D_MODEL=
