{
  "name": "drawing-racing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "shared",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client && node -e \"require('fs').cpSync('client/dist','dist',{recursive:true,force:true})\"",
    "preview": "npm run preview -w client",
    "test": "npm run test -w shared",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w client"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
